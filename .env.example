DATABASE_URL=sqlite+aiosqlite:///./data/app.db
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_NUM_WORKERS=2
MAX_CONCURRENT_DOWNLOADS=2
MAX_CONCURRENT_TRANSCRIBE=2
PREFER_CAPTIONS=true
# Optional YouTube authentication. Set one browser name while logged into
# YouTube (chrome, firefox, edge, brave), or use a Netscape cookies.txt file.
YT_COOKIES_FROM_BROWSER=
YT_COOKIES_FILE=
DOWNLOAD_JITTER_MIN_SECONDS=1.0
DOWNLOAD_JITTER_MAX_SECONDS=4.0
BOT_CHECK_COOLDOWN_MINUTES=15
YT_GLOBAL_MIN_INTERVAL_SECONDS=2.0
# 24h and custom-hours syncs use YouTube's RSS feed for precise, low-volume
# recent-video lookups. Larger windows use incremental yt-dlp listings.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
DOWNLOAD_DIR=./downloads
MAX_SEARCH_RESULTS=20
DEFAULT_TIME_WINDOW=7d

# Optional: YouTube Data API v3 key for accurate published_at and duration
# on all videos. When set, the app uses the API as the preferred data source
# instead of RSS+yt-dlp, giving complete metadata coverage for all videos
# in a channel (not just the 15 most recent). Free tier: 10,000 quota units/day.
# Obtain from Google Cloud Console: enable "YouTube Data API v3", create API key.
# When unset, the app falls back to RSS+yt-dlp (existing behavior).
YOUTUBE_DATA_API_KEY=
# Local bgutil-ytdlp-pot-provider server. Must be running before yt-dlp calls.
YT_POT_PROVIDER_BASE_URL=http://127.0.0.1:4416
